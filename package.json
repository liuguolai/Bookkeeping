{
  "name": "pocket-ledger",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "native:sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "preview:pwa": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:sync": "playwright test --config playwright.sync.config.ts",
    "cloud:dev": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "cloud:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "cloud:migrate": "wrangler d1 migrations apply DB --remote",
    "cloud:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.0.0",
    "wrangler": "4.149.0"
  }
}
