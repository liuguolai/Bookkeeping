{
  "name": "pocket-ledger-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "ratelimits": [{ "name": "AUTH_RATE_LIMIT", "namespace_id": "2026101002", "simple": { "limit": 1000, "period": 60 } }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocket-ledger-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "SYNC_SETUP_CODE": "local-development-only" },
}
